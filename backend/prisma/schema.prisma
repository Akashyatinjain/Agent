generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  hashedPassword String
  name           String
  avatar         String?
  settings       Json           @default("{}")

  conversations  Conversation[]
  files          File[]
  documents      Document[]
  memories       Memory[]
  channels       UserChannel[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  Message[]
  documents Document[]

  model     String    @default("gemini")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  role           MessageRole
  content        String        @db.Text

  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  model          String?
  routerType     String?
  toolCalls      Json?
  ragContext     Json?
  tokenCount     Int?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId])
}

model File {
  id        String     @id @default(cuid())
  name      String
  type      String
  size      Int
  s3Key     String

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents Document[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model Document {
  id             String         @id @default(cuid())
  content        String         @db.Text
  metadata       Json

  embedding      Unsupported("vector(1536)")?

  fileId         String?
  file           File?          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([fileId])
  @@index([conversationId])
}

model Memory {
  id        String   @id @default(cuid())
  fact      String   @db.Text
  category  String   @default("general")

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserChannel {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelType          String
  channelUserId        String
  channelUsername      String?
  linkingCode          String?
  linkingCodeExpiresAt DateTime?
  isVerified           Boolean   @default(false)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([channelUserId])
  @@index([linkingCode])
}